---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <img src="/logo.jpg" alt="TypingWire" class="footer-logo" width="28" height="28" />
          <span class="brand-name">TypingWire</span>
        </a>
        <p class="brand-tagline">
          The knowledge hub for speed typists, exam aspirants, and mechanical keyboard enthusiasts.
        </p>
      </div>

      <div class="footer-nav-grid">
        <div class="nav-group">
          <span class="group-title">Platform</span>
          <ul>
            <li><a href="https://typingwire.in" target="_blank" rel="noopener noreferrer">Typing Test</a></li>
            <li><a href="https://typingwire.in" target="_blank" rel="noopener noreferrer">Hindi Typing</a></li>
            <li><a href="https://typingwire.in" target="_blank" rel="noopener noreferrer">Exam Passages</a></li>
          </ul>
        </div>

        <div class="nav-group">
          <span class="group-title">Guides</span>
          <ul>
            <li><a href="/categories/typing-tips">Speed Drills</a></li>
            <li><a href="/categories/exam-rules">Exam Rules</a></li>
            <li><a href="/categories/hardware">Keyboards</a></li>
          </ul>
        </div>

        <div class="nav-group">
          <span class="group-title">Company</span>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy-policy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {currentYear} TypingWire. All rights reserved.</p>
      <div class="legal-links">
        <a href="/privacy-policy">Privacy</a>
        <span class="dot">·</span>
        <a href="/terms">Terms</a>
        <span class="dot">·</span>
        <a href="/disclaimer">Disclaimer</a>
        <span class="dot">·</span>
        <a href="/sitemap.xml">Sitemap</a>
        <span class="dot">·</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--colors-hairline);
    background-color: #fafafa;
    margin-top: 6rem;
    padding: 4rem 0 2.5rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--colors-hairline);
  }

  .footer-brand {
    max-width: 320px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--colors-primary);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.3px;
    margin-bottom: 0.75rem;
  }

  .footer-logo {
    border-radius: var(--rounded-sm);
    object-fit: cover;
  }

  .brand-tagline {
    font-size: 13.5px;
    color: var(--colors-muted-text);
    line-height: 1.55;
    margin: 0;
  }

  .footer-nav-grid {
    display: flex;
    gap: 4.5rem;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
  }

  .group-title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--colors-primary);
    margin-bottom: 1rem;
  }

  .nav-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .nav-group a {
    font-size: 13.5px;
    color: var(--colors-muted-text);
    transition: color 0.15s ease;
  }

  .nav-group a:hover {
    color: var(--colors-primary);
  }

  .footer-bottom {
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    color: var(--colors-muted-text);
  }

  .copyright {
    margin: 0;
    font-size: 12.5px;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .legal-links a {
    color: var(--colors-muted-text);
    transition: color 0.15s ease;
  }

  .legal-links a:hover {
    color: var(--colors-primary);
  }

  .dot {
    color: var(--colors-hairline);
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
      gap: 2.5rem;
    }
    .footer-nav-grid {
      gap: 3rem;
      flex-wrap: wrap;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>
