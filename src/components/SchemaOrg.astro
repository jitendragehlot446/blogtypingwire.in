---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  type?: 'WebSite' | 'Article';
  title: string;
  description: string;
  url: string;
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  faqs?: FAQ[];
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  type = 'WebSite',
  title,
  description,
  url,
  image,
  pubDate,
  updatedDate,
  author = 'TypingWire Team',
  faqs = [],
  breadcrumbs = [],
} = Astro.props;

const fallbackImage = 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=1200&auto=format&fit=crop&q=80';
const articleImage = image || fallbackImage;

// 1. Article or WebSite schema
const mainSchema = type === 'Article' ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'image': articleImage,
  'inLanguage': 'en-IN',
  'isAccessibleForFree': 'true',
  'author': [
    {
      '@type': 'Organization',
      'name': author || 'TypingWire Editorial Board',
      'url': 'https://typingwire.in'
    },
    {
      '@type': 'Person',
      'name': 'Jitendra Gehlot',
      'jobTitle': 'Government Typing Examination Specialist',
      'url': 'https://typingwire.in/about'
    }
  ],
  'reviewedBy': {
    '@type': 'Person',
    'name': 'Jitendra Gehlot',
    'jobTitle': 'Senior Examination Analyst & Speed Coach',
    'url': 'https://typingwire.in/about'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'TypingWire',
    'url': 'https://typingwire.in',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://blog.typingwire.in/logo.jpg'
    }
  },
  'datePublished': pubDate ? pubDate.toISOString() : undefined,
  'dateModified': (updatedDate || pubDate) ? (updatedDate || pubDate)!.toISOString() : undefined,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': url
  }
} : {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'TypingWire Blog',
  'url': url,
  'description': description,
  'publisher': {
    '@type': 'Organization',
    'name': 'TypingWire',
    'url': 'https://typingwire.in'
  }
};

// 2. Breadcrumbs schema
const breadcrumbsSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.name,
    'item': item.url
  }))
} : null;

// 3. FAQ Schema
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />
{breadcrumbsSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
