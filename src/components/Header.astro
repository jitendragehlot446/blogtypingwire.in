---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<header class="top-nav">
  <nav>
    <h2>
      <a href="/" class="logo">
        <img src="/logo.jpg" alt="TypingWire Logo" class="logo-img" width="32" height="32" />
        TypingWire
      </a>
    </h2>

    <div class="internal-links">
      <a href="/" class={currentPath === "" ? "active" : ""}>Home</a>
      <a href="/categories/typing-tips" class={currentPath.includes("typing-tips") ? "active" : ""}>Speed Tips</a>
      <a href="/categories/exam-rules" class={currentPath.includes("exam-rules") ? "active" : ""}>Exam Rules</a>
      <a href="/categories/hardware" class={currentPath.includes("hardware") ? "active" : ""}>Hardware</a>
      <a href="/about" class={currentPath.includes("about") ? "active" : ""}>About</a>
    </div>

    <div class="cta-pair">
      <a href="/categories/exam-rules" class="button-secondary">Read Guides</a>
      <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">Free Mock Test</a>
    </div>
  </nav>
</header>

<style>
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--colors-canvas);
    border-bottom: 1px solid var(--colors-hairline);
  }

  nav {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--colors-primary);
    text-decoration: none;
    letter-spacing: -0.3px;
  }

  .logo-img {
    width: 32px;
    height: 32px;
    border-radius: var(--rounded-sm);
    object-fit: cover;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .internal-links a {
    color: var(--colors-muted-text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .internal-links a:hover,
  .internal-links a.active {
    color: var(--colors-primary);
    font-weight: 600;
  }

  .cta-pair {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 860px) {
    .internal-links {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .cta-pair .button-secondary {
      display: none;
    }
  }
</style>
