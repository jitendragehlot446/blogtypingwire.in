---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo">
      <img src="/logo.jpg" alt="TypingWire Logo" class="brand-logo-img" width="34" height="34" />
      <div class="logo-text">
        <span class="logo-title">TypingWire</span>
        <span class="post-card-badge">EDITORIAL</span>
      </div>
    </a>

    <nav class="main-nav">
      <a href="/" class={currentPath === "" ? "active" : ""}>Overview</a>
      <a href="/categories/typing-tips" class={currentPath.includes("typing-tips") ? "active" : ""}>Speed Drills</a>
      <a href="/categories/exam-rules" class={currentPath.includes("exam-rules") ? "active" : ""}>Exam Guidelines</a>
      <a href="/categories/hardware" class={currentPath.includes("hardware") ? "active" : ""}>Hardware</a>
    </nav>

    <div class="header-actions">
      <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">
        <span>Start Typing Test</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--colors-hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--colors-primary);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.3px;
  }

  .brand-logo-img {
    width: 34px;
    height: 34px;
    border-radius: var(--rounded-sm);
    object-fit: cover;
  }

  .logo-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .main-nav a {
    color: var(--colors-muted-text);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--colors-primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }
  }
</style>
