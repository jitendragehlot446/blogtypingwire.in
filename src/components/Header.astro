---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove first slash
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo">
      <div class="logo-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"></path>
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-title">Typing<span class="text-accent">Wire</span></span>
        <span class="logo-badge">BLOG</span>
      </div>
    </a>

    <nav class="main-nav">
      <a href="/" class={currentPath === "" ? "active" : ""}>Home</a>
      <a href="/categories/typing-tips" class={currentPath.includes("typing-tips") ? "active" : ""}>Speed Tips</a>
      <a href="/categories/exam-rules" class={currentPath.includes("exam-rules") ? "active" : ""}>Exam Rules</a>
      <a href="/categories/hardware" class={currentPath.includes("hardware") ? "active" : ""}>Keyboards</a>
    </nav>

    <div class="header-actions">
      <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="btn btn-primary app-btn">
        <span>Start Typing Test</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    background: rgba(10, 14, 23, 0.85);
    border-bottom: 1px solid var(--border-color);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(129, 140, 248, 0.2));
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-accent);
  }

  .logo-text {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .text-accent {
    color: var(--brand-accent);
  }

  .logo-badge {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(56, 189, 248, 0.15);
    color: var(--brand-accent);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    letter-spacing: 0.05em;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .main-nav a {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: #ffffff;
  }

  .app-btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }
    .app-btn span {
      display: none;
    }
  }
</style>
