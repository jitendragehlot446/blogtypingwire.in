---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category?: string;
  tags?: string[];
  featured?: boolean;
}

const { title, description, pubDate, slug, category = 'General', tags = [], featured = false } = Astro.props;
---

<article class={`blog-card card-glass ${featured ? 'card-featured' : ''}`}>
  <div class="card-header">
    <a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}`} class="badge">
      {category}
    </a>
    <span class="card-date">
      <FormattedDate date={pubDate} />
    </span>
  </div>

  <h3 class="card-title">
    <a href={`/blog/${slug}`}>{title}</a>
  </h3>

  <p class="card-description">
    {description}
  </p>

  <div class="card-footer">
    <div class="card-tags">
      {tags.slice(0, 2).map((t) => (
        <span class="tag-item">#{t}</span>
      ))}
    </div>

    <a href={`/blog/${slug}`} class="read-more-link">
      <span>Read Article</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    height: 100%;
    position: relative;
  }

  .card-featured {
    border-color: rgba(56, 189, 248, 0.4);
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.9) 0%, rgba(30, 41, 59, 0.8) 100%);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-date {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .card-title {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .card-title a {
    color: #ffffff;
  }

  .card-title a:hover {
    color: var(--brand-accent);
  }

  .card-description {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    font-size: 0.85rem;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag-item {
    color: var(--text-dim);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--brand-accent);
  }

  .read-more-link:hover {
    gap: 0.55rem;
  }
</style>
