---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category?: string;
  tags?: string[];
  heroImage?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  pubDate,
  slug,
  category = 'Exam Rules',
  heroImage,
  imageAlt = title,
} = Astro.props;

// Placeholder images tailored for typing topics if heroImage not provided
const getPlaceholderImage = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('speed') || c.includes('tips')) {
    return 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=720&auto=format&fit=crop&q=80';
  }
  if (c.includes('hardware') || c.includes('keyboard')) {
    return 'https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=720&auto=format&fit=crop&q=80';
  }
  return 'https://images.unsplash.com/photo-1455390582262-044cdead277a?w=720&auto=format&fit=crop&q=80';
};

const displayImage = heroImage || getPlaceholderImage(category);
---

<article class="post-card">
  <a href={`/blog/${slug}`}>
    <div class="post-card-image-container">
      <img src={displayImage} alt={imageAlt} loading="lazy" decoding="async" width="720" height="360" />
      <span class="post-card-badge">{category}</span>
    </div>
    <div class="post-card-body">
      <h3 class="card-title">{title}</h3>
      <p class="post-card-desc">{description}</p>
      <span class="caption date">
        <FormattedDate date={pubDate} />
      </span>
    </div>
  </a>
</article>

<style>
  .post-card {
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--colors-primary);
  }

  .post-card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card-image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-bottom: 1px solid var(--colors-hairline);
    background-color: var(--colors-surface-soft);
  }

  .post-card-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-image-container img {
    transform: scale(1.03);
  }

  .post-card-badge {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--colors-primary);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: var(--rounded-pill);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    z-index: 2;
  }

  .post-card-body {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-card-body h3 {
    margin-top: 0;
    margin-bottom: var(--spacing-xs);
    font-size: 18.5px;
    line-height: 1.4;
  }

  .post-card-desc {
    font-size: 14px;
    color: var(--colors-muted-text);
    line-height: 1.55;
    margin-bottom: var(--spacing-md);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-body .date {
    margin-top: auto;
  }
</style>
