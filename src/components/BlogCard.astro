---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category?: string;
  tags?: string[];
  featured?: boolean;
}

const { title, description, pubDate, slug, category = 'General', tags = [], featured = false } = Astro.props;

// Assign pastel badge classes based on category
const getBadgeClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('tips') || c.includes('speed')) return 'badge-mint';
  if (c.includes('exam') || c.includes('rule')) return 'badge-lilac';
  if (c.includes('hardware') || c.includes('keyboard')) return 'badge-cream';
  return 'badge-lime';
};
---

<article class={`editorial-card ${featured ? 'card-featured' : ''}`}>
  <div class="card-top">
    <a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}`} class={`post-card-badge ${getBadgeClass(category)}`}>
      {category}
    </a>
    <span class="card-date">
      <FormattedDate date={pubDate} />
    </span>
  </div>

  <h3 class="card-title">
    <a href={`/blog/${slug}`}>{title}</a>
  </h3>

  <p class="card-description">
    {description}
  </p>

  <div class="card-bottom">
    <div class="card-tags">
      {tags.slice(0, 2).map((t) => (
        <span class="tag-item">#{t}</span>
      ))}
    </div>

    <a href={`/blog/${slug}`} class="read-link">
      <span>Read Article</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .editorial-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    height: 100%;
    background-color: var(--colors-canvas);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-lg);
    box-shadow: var(--shadow-subtle);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .editorial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-float);
    border-color: #cbd5e1;
  }

  .card-featured {
    background-color: var(--colors-surface-soft);
    border-color: #d1d5db;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--colors-muted-text);
  }

  .card-title {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .card-title a {
    color: var(--colors-primary);
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: #4b5563;
  }

  .card-description {
    color: var(--colors-body-text);
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--colors-hairline);
    padding-top: 1.25rem;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag-item {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--colors-muted-text);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--colors-primary);
  }

  .read-link:hover {
    gap: 0.55rem;
  }
</style>
