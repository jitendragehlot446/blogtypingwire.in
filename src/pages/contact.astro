---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us - TypingWire"
  description="Get in touch with the TypingWire editorial team for inquiries, corrections, hardware review submissions, and feedback."
>
  <div class="prose-container contact-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Contact</span>
    </nav>

    <div class="header-tags">
      <span class="post-card-badge badge-lilac">GET IN TOUCH</span>
    </div>

    <h1 class="display-lg">We’d love to hear from you.</h1>
    <p class="lead-text">
      Have a question about a typing exam rule, feedback on our speed drills, or a keyboard review proposal? Contact our editorial and technical team.
    </p>

    <hr class="section-divider" />

    <div class="contact-grid">
      <div class="contact-card">
        <div class="contact-icon">📧</div>
        <h3>Email Editorial Support</h3>
        <p>For general inquiries, corrections, or suggestions:</p>
        <a href="mailto:support@typingwire.in" class="contact-link">support@typingwire.in</a>
      </div>

      <div class="contact-card">
        <div class="contact-icon">🌐</div>
        <h3>Main Platform</h3>
        <p>For account support, mock tests, or software features:</p>
        <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="contact-link">typingwire.in</a>
      </div>
    </div>

    <div class="faq-snippet">
      <h2>Quick Assistance</h2>
      <div class="faq-box">
        <strong>Found an error in our exam guidelines?</strong>
        <p>Government exam evaluation rules (like SSC CGL or High Court) change with official notifications. If you notice any formula update, please email us with the official notification link and our editors will update the guide within 24 hours.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding: 3.5rem 1.5rem 5rem;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--colors-muted-text);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--colors-primary);
  }

  .lead-text {
    font-size: 20px;
    color: var(--colors-muted-text);
    line-height: 1.6;
    margin: 1.5rem 0 2rem;
  }

  .section-divider {
    border: 0;
    height: 1px;
    background-color: var(--colors-hairline);
    margin: 2.5rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0 3.5rem;
  }

  .contact-card {
    padding: 2rem;
    background-color: var(--colors-surface-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
  }

  .contact-icon {
    font-size: 28px;
    margin-bottom: 1rem;
  }

  .contact-card h3 {
    font-size: 18px;
    margin: 0 0 0.5rem;
  }

  .contact-card p {
    font-size: 14.5px;
    color: var(--colors-muted-text);
    margin-bottom: 1rem;
  }

  .contact-link {
    font-weight: 600;
    color: var(--colors-primary);
    text-decoration: underline;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .faq-snippet h2 {
    font-size: 24px;
    margin-bottom: 1.25rem;
  }

  .faq-box {
    padding: 1.5rem;
    background-color: var(--colors-block-cream);
    border: 1px solid #fef08a;
    border-radius: var(--rounded-md);
  }

  .faq-box strong {
    color: #713f12;
    display: block;
    margin-bottom: 0.5rem;
  }

  .faq-box p {
    color: #854d0e;
    font-size: 14.5px;
    margin: 0;
    line-height: 1.6;
  }
</style>
