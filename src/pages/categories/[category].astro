---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Extract all unique categories
  const categories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];

  return categories.map((cat) => {
    const slug = cat.toLowerCase().replace(/\s+/g, '-');
    const filteredPosts = allPosts
      .filter((post) => post.data.category === cat)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: slug },
      props: { categoryName: cat, posts: filteredPosts },
    };
  });
}

const { categoryName, posts } = Astro.props;
---

<BaseLayout
  title={`${categoryName} Articles & Guides`}
  description={`Explore all expert articles, tips, and guides in the ${categoryName} category on TypingWire Blog.`}
>
  <section class="category-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Categories</span>
        <span class="sep">/</span>
        <span class="current">{categoryName}</span>
      </nav>
      <div class="badge">{categoryName}</div>
      <h1 class="cat-title">{categoryName} Articles</h1>
      <p class="cat-desc">
        Browse {posts.length} {posts.length === 1 ? 'article' : 'articles'} covering {categoryName.toLowerCase()} and related strategies.
      </p>
    </div>
  </section>

  <section class="category-posts">
    <div class="container">
      <div class="posts-grid">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-header {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-color);
    background: rgba(17, 24, 39, 0.4);
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .cat-title {
    font-size: 2.4rem;
    margin: 0.75rem 0 0.5rem;
  }

  .cat-desc {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .category-posts {
    padding: 3.5rem 0 5rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }
</style>
