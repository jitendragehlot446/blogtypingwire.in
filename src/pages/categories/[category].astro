---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Extract all unique categories
  const categories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];

  return categories.map((cat) => {
    const slug = cat.toLowerCase().replace(/\s+/g, '-');
    const filteredPosts = allPosts
      .filter((post) => post.data.category === cat)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: slug },
      props: { categoryName: cat, posts: filteredPosts },
    };
  });
}

const { categoryName, posts } = Astro.props;

const getBadgeClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('tips') || c.includes('speed')) return 'badge-mint';
  if (c.includes('exam') || c.includes('rule')) return 'badge-lilac';
  if (c.includes('hardware') || c.includes('keyboard')) return 'badge-cream';
  return 'badge-lime';
};
---

<BaseLayout
  title={`${categoryName} - TypingWire Editorial`}
  description={`Explore all expert articles, tips, and guides in the ${categoryName} category on TypingWire Blog.`}
>
  <section class="category-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Categories</span>
        <span class="sep">/</span>
        <span class="current">{categoryName}</span>
      </nav>
      <span class={`post-card-badge ${getBadgeClass(categoryName)}`}>{categoryName}</span>
      <h1 class="display-lg cat-title">{categoryName}</h1>
      <p class="cat-desc">
        Showing {posts.length} {posts.length === 1 ? 'article' : 'articles'} covering {categoryName.toLowerCase()} and related precision strategies.
      </p>
    </div>
  </section>

  <section class="category-posts">
    <div class="container">
      <div class="editorial-grid">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-header {
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas);
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--colors-muted-text);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--colors-primary);
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .cat-title {
    margin: 1rem 0 0.5rem;
  }

  .cat-desc {
    color: var(--colors-muted-text);
    font-size: 18px;
    margin: 0;
  }

  .category-posts {
    padding: 4rem 0 6rem;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 2rem;
  }
</style>
