---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const marqueeExams = [
  'SSC CHSL', 'RRB NTPC', 'SSC CGL', 'UP POLICE ASI', 'DELHI POLICE HC',
  'HIGH COURT LDC', 'DSSSB LDC', 'RSMSSB LDC', 'ARMY CLERK', 'CISF HC',
  'BSF HC', 'CRPF ASI', 'PATNA HIGH COURT', 'ALLAHABAD HIGH COURT', 'BOMBAY HIGH COURT',
  'GUJARAT HIGH COURT', 'MP HIGH COURT AG-3', 'CHHATTISGARH HC'
];
---

<BaseLayout
  title="TypingWire Blog - Official Exam Rules, Typing Guidelines & Speed Drills | TypingWire.in"
  description="The official examination rules and speed training portal of TypingWire.in. Master speed, accuracy, and mistake calculation formulas for SSC CGL, CHSL, High Courts, DSSSB, and Steno exams."
>
  <!-- Hero Section -->
  <section class="hero">
    <span class="eyebrow">Introducing TypingWire Blog</span>
    <h1 class="sr-only">TypingWire Blog</h1>
    <div class="display-xl hero-title">Type faster. Pass exams.</div>
    <p class="body-lg">
      The ultimate online knowledge and practice portal for Indian government typing examinations. Master speed, accuracy, and error evaluation formulas for SSC CHSL, CGL, High Courts, DSSSB, and State Exams on <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" style="color:var(--colors-primary); text-decoration:underline;">TypingWire.in</a>.
    </p>
    <div class="cta-buttons">
      <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">Try a mock test</a>
      <a href="/categories/exam-rules" class="button-secondary">Read Guides</a>
    </div>
  </section>

  <!-- Animated Marquee Strip -->
  <div class="marquee-strip">
    <div class="marquee-content">
      {marqueeExams.map((exam) => (
        <>
          <span class="marquee-item">{exam}</span>
          <span class="marquee-item">·</span>
        </>
      ))}
      {marqueeExams.map((exam) => (
        <>
          <span class="marquee-item">{exam}</span>
          <span class="marquee-item">·</span>
        </>
      ))}
    </div>
  </div>

  <main>
    <!-- Lilac Block: Layout Ergonomics -->
    <section class="color-block color-block-lilac">
      <div class="block-content">
        <span class="eyebrow">Layout Ergonomics</span>
        <h2 class="display-lg">Ergonomic keymaps.</h2>
        <p class="body">
          Learn how scientific touch-typing posture and home-row anchors reduce finger travel distance by up to 60%, preventing repetitive strain injuries (RSI) while boosting speed past 80+ WPM.
        </p>
        <a href="/categories/typing-tips" class="button-primary">Learn Speed Drills</a>
      </div>
    </section>

    <!-- Mint Block: Exam Preparation -->
    <section class="color-block color-block-mint">
      <div class="block-content">
        <span class="eyebrow">Exam Preparation</span>
        <h2 class="display-lg">Exact exam simulations.</h2>
        <p class="body">
          Practice on interfaces that exactly mirror exams like SSC CGL DEST, CHSL, DSSSB, Supreme Court JCA, and High Court LDC. Configure custom settings including Remington Gail, Inscript, or Krutidev, with disabled backspace options.
        </p>
        <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">Try exam simulations</a>
      </div>
    </section>

    <!-- Navy Block (Dark): Performance Metrics -->
    <section class="color-block color-block-navy">
      <div class="block-content">
        <span class="eyebrow">Performance Metrics</span>
        <h2 class="display-lg">Analyze your mistakes.</h2>
        <p class="body">
          Track your typing speed (WPM) and accuracy in real-time. TypingWire maps your errors and highlights specific bottleneck keys and mistyped combinations to help you optimize your speed for competitive exams.
        </p>
        <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-secondary">Analyze your typing</a>
      </div>
    </section>

    <!-- Recent Posts Grid (White Canvas) -->
    <div class="container">
      <section class="section-heading">
        <h2 class="headline">Recent Blog Posts</h2>
        <a href="/categories/exam-rules">View all posts &rarr;</a>
      </section>

      <section class="posts-grid">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            category={post.data.category}
            tags={post.data.tags}
            heroImage={post.data.heroImage}
            imageAlt={post.data.imageAlt}
          />
        ))}
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--spacing-section) var(--spacing-md) calc(var(--spacing-section) * 1.5);
    background-color: var(--colors-canvas);
  }

  .hero .eyebrow {
    color: var(--colors-primary);
    margin-bottom: var(--spacing-md);
    display: block;
  }

  .hero h1,
  .hero .hero-title {
    margin-bottom: var(--spacing-lg);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero p {
    color: var(--colors-primary);
    max-width: 680px;
    margin: 0 auto var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Marquee Strip */
  .marquee-strip {
    background-color: var(--colors-inverse-canvas);
    color: var(--colors-on-primary);
    height: 48px;
    overflow: hidden;
    display: flex;
    align-items: center;
    white-space: nowrap;
    border-top: 1px solid var(--colors-primary);
    border-bottom: 1px solid var(--colors-primary);
  }

  .marquee-content {
    display: inline-flex;
    animation: marquee 30s linear infinite;
    gap: var(--spacing-xl);
    padding-left: var(--spacing-xl);
  }

  .marquee-item {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  @keyframes marquee {
    0% {
      transform: translate(0);
    }
    100% {
      transform: translate(-50%);
    }
  }

  /* Section Heading */
  .section-heading {
    margin-top: var(--spacing-section);
    margin-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: var(--spacing-sm);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .section-heading a {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 540;
    text-decoration: none;
    color: var(--colors-primary);
  }

  .section-heading a:hover {
    text-decoration: underline;
  }

  /* 3-Column Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-section);
  }

  @media (max-width: 960px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
