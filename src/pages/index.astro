---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts.find((post) => post.data.featured) || posts[0];
const regularPosts = posts.filter((post) => post.id !== featuredPost?.id);

const categories = [
  { name: 'All', slug: '/' },
  { name: 'Speed Drills', slug: '/categories/typing-tips' },
  { name: 'Exam Guidelines', slug: '/categories/exam-rules' },
  { name: 'Hardware', slug: '/categories/hardware' },
];
---

<BaseLayout
  title="TypingWire Blog - Official Exam Rules, Typing Guidelines & Speed Drills | TypingWire.in"
  description="Official examination rules & guidelines subdomain of TypingWire.in. Verified evaluation formulas, Full vs Half mistake rules for SSC CGL, CHSL, High Court, Steno, and touch-typing drills."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-label">
        <span class="post-card-badge badge-mint">OFFICIAL SUBDOMAIN OF TYPINGWIRE.IN</span>
        <span class="edition-tag">EXAM RULES & SPEED PORTAL</span>
      </div>

      <h1 class="display-xl hero-headline">
        Government Typing Exam Rules, <br />
        Evaluation Guidelines & Speed Drills.
      </h1>

      <p class="hero-subtext">
        This portal is the official knowledge and examination rules subdomain of <strong><a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="link-highlight">TypingWire.in</a></strong>. Here we publish verified government typing test guidelines, full mistake vs half mistake error calculation formulas (SSC CGL, CHSL, High Court, Steno, DSSSB, RRB), accuracy drills, and keyboard mechanics to help you rank and pass your typing skill tests.
      </p>

      <!-- Category Navigation Pills -->
      <div class="category-filters">
        {categories.map((cat, i) => (
          <a href={cat.slug} class={`cat-pill ${i === 0 ? 'active' : ''}`}>
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section">
    <div class="container">
      {featuredPost && (
        <div class="featured-block">
          <div class="block-header">
            <span class="section-kicker">FEATURED INSIGHT</span>
          </div>
          <BlogCard
            title={featuredPost.data.title}
            description={featuredPost.data.description}
            pubDate={featuredPost.data.pubDate}
            slug={featuredPost.id}
            category={featuredPost.data.category}
            tags={featuredPost.data.tags}
            featured={true}
          />
        </div>
      )}

      <!-- Pastel Mock Test CTA Card (Mint Block) -->
      <div class="mint-cta-block">
        <div class="cta-inner">
          <span class="post-card-badge" style="background:#ffffff;">FREE TOOL</span>
          <h2 class="headline cta-title">Test Your Live WPM & Accuracy in 60 Seconds</h2>
          <p class="cta-desc">Instant error breakdown, live keystroke velocity, and certificate generation.</p>
          <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">
            Start Live Test →
          </a>
        </div>
      </div>

      <div class="section-title-row">
        <h2 class="headline">Recent Publications</h2>
        <span class="count-badge">{posts.length} Guides Available</span>
      </div>

      <div class="editorial-grid">
        {regularPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 5rem 0 3.5rem;
    border-bottom: 1px solid var(--colors-hairline);
    background-color: var(--colors-canvas);
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .edition-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colors-muted-text);
    letter-spacing: 0.05em;
  }

  .hero-headline {
    margin-bottom: 1.5rem;
  }

  .hero-subtext {
    font-size: 17.5px;
    color: var(--colors-muted-text);
    max-width: 780px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .link-highlight {
    color: var(--colors-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .category-filters {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .cat-pill {
    padding: 7px 18px;
    border-radius: var(--rounded-pill);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--colors-body-text);
    background-color: var(--colors-surface-soft);
    border: 1px solid var(--colors-hairline);
    transition: all 0.15s ease;
  }

  .cat-pill:hover,
  .cat-pill.active {
    background-color: var(--colors-primary);
    color: var(--colors-on-primary);
    border-color: var(--colors-primary);
  }

  /* Content Section */
  .content-section {
    padding: 4rem 0 6rem;
  }

  .featured-block {
    margin-bottom: 3.5rem;
  }

  .block-header {
    margin-bottom: 1rem;
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--colors-muted-text);
  }

  /* Pastel Mint CTA Block */
  .mint-cta-block {
    background-color: var(--colors-block-mint);
    border: 1px solid #bbf7e6;
    border-radius: var(--rounded-lg);
    padding: 3rem 2.5rem;
    margin-bottom: 4rem;
  }

  .cta-inner {
    max-width: 620px;
  }

  .cta-title {
    margin: 1rem 0 0.5rem;
    color: #064e3b;
    font-weight: 700;
  }

  .cta-desc {
    color: #047857;
    font-size: 16px;
    margin-bottom: 1.5rem;
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--colors-hairline);
  }

  .count-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--colors-muted-text);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3.5rem 0 2.5rem;
    }
    .mint-cta-block {
      padding: 2rem 1.5rem;
    }
  }
</style>
