---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page or guide you are looking for does not exist."
>
  <div class="container notfound-wrapper">
    <div class="notfound-content card-glass">
      <div class="error-badge">404 ERROR</div>
      <h1>Guide Not Found</h1>
      <p>The page you are looking for might have been moved or doesn't exist.</p>
      <div class="notfound-actions">
        <a href="/" class="btn btn-primary">Back to Homepage</a>
        <a href="https://typingwire.in" class="btn btn-outline">Go to TypingWire App</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 3rem 1.5rem;
  }

  .notfound-content {
    text-align: center;
    max-width: 550px;
    padding: 3.5rem 2.5rem;
    border-color: rgba(56, 189, 248, 0.25);
  }

  .error-badge {
    display: inline-block;
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
  }

  .notfound-content h1 {
    margin-top: 0;
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
  }

  .notfound-content p {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  .notfound-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
