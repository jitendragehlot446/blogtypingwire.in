---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  imageAlt?: string;
  category?: string;
  tags?: string[];
  author?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  imageAlt,
  category = 'General',
  tags = [],
  author = 'TypingWire Team',
  faqs = [],
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://blog.typingwire.in';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: category, url: `${siteUrl}/categories/${category.toLowerCase().replace(/\s+/g, '-')}` },
  { name: title, url: currentUrl },
];

const getBadgeClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('tips') || c.includes('speed')) return 'badge-mint';
  if (c.includes('exam') || c.includes('rule')) return 'badge-lilac';
  if (c.includes('hardware') || c.includes('keyboard')) return 'badge-cream';
  return 'badge-lime';
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  articleDate={pubDate}
  author={author}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="prose-container blog-detail-wrapper">
    <!-- Breadcrumb bar -->
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}`}>{category}</a>
      <span class="sep">/</span>
      <span class="current">{title.slice(0, 32)}...</span>
    </nav>

    <!-- Post Header -->
    <header class="post-header">
      <div class="header-tags">
        <a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}`} class={`post-card-badge ${getBadgeClass(category)}`}>
          {category}
        </a>
      </div>
      <h1 class="display-lg post-title">{title}</h1>
      <p class="post-lead">{description}</p>

      <div class="post-meta">
        <div class="author-info">
          <span class="author-label">WRITTEN BY</span>
          <span class="author-name">{author}</span>
        </div>
        <span class="meta-sep">•</span>
        <div class="publish-date">
          <span class="date-label">PUBLISHED</span>
          <FormattedDate date={pubDate} />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <article class="article-content">
      <slot />
    </article>

    <!-- Interactive FAQ Section if present -->
    {
      faqs && faqs.length > 0 && (
        <section class="faq-container">
          <h2 class="headline">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <span class="faq-icon">+</span>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <!-- Tags -->
    {
      tags.length > 0 && (
        <div class="tags-section">
          <span class="tags-label">INDEXED UNDER:</span>
          <div class="tags-list">
            {tags.map((t) => (
              <span class="tag-pill">#{t}</span>
            ))}
          </div>
        </div>
      )
    }

    <!-- High-conversion Pastel CTA Card (Mint Block) -->
    <div class="post-cta-block">
      <div class="cta-inner">
        <span class="post-card-badge" style="background:#ffffff;">TYPING PRACTICE</span>
        <h3>Benchmark Your Keystrokes on TypingWire</h3>
        <p>Real-time accuracy analysis, exam passages, and speed benchmarks.</p>
        <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">
          Start Typing Test →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-detail-wrapper {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .breadcrumb-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--colors-muted-text);
    margin-bottom: 2rem;
  }

  .breadcrumb-bar a {
    color: var(--colors-primary);
  }

  .breadcrumb-bar a:hover {
    text-decoration: underline;
  }

  .post-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: 2.5rem;
  }

  .header-tags {
    margin-bottom: 1.25rem;
  }

  .post-title {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .post-lead {
    font-size: 20px;
    color: var(--colors-muted-text);
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colors-muted-text);
  }

  .author-info, .publish-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .author-label, .date-label {
    color: var(--colors-muted-text);
    font-weight: 500;
  }

  .author-name {
    color: var(--colors-primary);
    font-weight: 600;
  }

  .meta-sep {
    color: var(--colors-hairline);
  }

  /* FAQs */
  .faq-container {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--colors-hairline);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .faq-item {
    padding: 1.25rem 1.5rem;
    background-color: var(--colors-surface-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
  }

  .faq-question {
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--colors-primary);
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-answer {
    margin-top: 0.75rem;
    font-size: 15px;
    color: var(--colors-body-text);
    line-height: 1.65;
  }

  /* Tags */
  .tags-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colors-muted-text);
    font-weight: 600;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--colors-surface-soft);
    color: var(--colors-primary);
    padding: 0.25rem 0.65rem;
    border-radius: var(--rounded-xs);
    border: 1px solid var(--colors-hairline);
  }

  /* CTA Banner */
  .post-cta-block {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    background-color: var(--colors-block-mint);
    border: 1px solid #bbf7e6;
    border-radius: var(--rounded-lg);
  }

  .post-cta-block h3 {
    margin: 1rem 0 0.5rem;
    font-size: 24px;
    color: #064e3b;
    font-weight: 700;
  }

  .post-cta-block p {
    margin: 0 0 1.5rem;
    color: #047857;
    font-size: 15.5px;
  }

  @media (max-width: 768px) {
    .blog-detail-wrapper {
      padding-top: 2.5rem;
    }
    .post-cta-block {
      padding: 2rem 1.5rem;
    }
  }
</style>
