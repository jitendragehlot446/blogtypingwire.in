---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  imageAlt?: string;
  category?: string;
  tags?: string[];
  author?: string;
  faqs?: Array<{ question: string; answer: string }>;
  currentSlug?: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  imageAlt,
  category = 'General',
  tags = [],
  author = 'TypingWire Team',
  faqs = [],
  currentSlug,
  headings = [],
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2);

const siteUrl = Astro.site?.toString() || 'https://blog.typingwire.in';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: category, url: `${siteUrl}/categories/${category.toLowerCase().replace(/\s+/g, '-')}` },
  { name: title, url: currentUrl },
];

const getBadgeClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('tips') || c.includes('speed')) return 'badge-mint';
  if (c.includes('exam') || c.includes('rule')) return 'badge-lilac';
  if (c.includes('hardware') || c.includes('keyboard')) return 'badge-cream';
  return 'badge-lime';
};

// Compute 3 high-relevance related posts based on tag overlap and category
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== currentSlug)
  .map((p) => {
    const postTags = p.data.tags || [];
    const sharedTags = postTags.filter((t: string) => tags.includes(t)).length;
    const sameCat = p.data.category === category ? 2 : 0;
    return { post: p, score: sharedTags * 3 + sameCat };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((item) => item.post);
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  articleDate={pubDate}
  author={author}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="prose-container blog-detail-wrapper">
    <!-- Breadcrumb bar -->
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}`}>{category}</a>
      <span class="sep">/</span>
      <span class="current">{title.slice(0, 32)}...</span>
    </nav>

    <!-- Post Header -->
    <header class="post-header">
      <div class="header-tags">
        <a href={`/categories/${category.toLowerCase().replace(/\s+/g, '-')}`} class={`post-card-badge ${getBadgeClass(category)}`}>
          {category}
        </a>
      </div>
      <h1 class="display-lg post-title">{title}</h1>
      <p class="post-lead">{description}</p>

      <div class="post-meta">
        <div class="author-info">
          <span class="author-label">WRITTEN BY</span>
          <span class="author-name">{author}</span>
        </div>
        <span class="meta-sep">•</span>
        <div class="reviewer-info">
          <span class="author-label">REVIEWED BY</span>
          <span class="author-name">Jitendra Gehlot</span>
        </div>
        <span class="meta-sep">•</span>
        <div class="publish-date">
          <span class="date-label">UPDATED FOR</span>
          <span class="author-name">2026 Cycles</span>
        </div>
      </div>
    </header>

    <!-- Automated Table of Contents (SERP Sitelinks Generator) -->
    {
      tocHeadings.length > 1 && (
        <nav class="toc-card" aria-label="Table of Contents">
          <details open class="toc-details">
            <summary class="toc-summary">
              <span class="toc-title">QUICK NAVIGATION (TABLE OF CONTENTS)</span>
              <span class="toc-icon">▼</span>
            </summary>
            <ol class="toc-list">
              {tocHeadings.map((h, index) => (
                <li class="toc-item">
                  <a href={`#${h.slug}`} class="toc-link">
                    <span class="toc-number">{index + 1}.</span> {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )
    }

    <!-- Main Content -->
    <article class="article-content">
      <slot />
    </article>

    <!-- Editorial Trust & E-E-A-T Verification Box -->
    <div class="editorial-trust-box">
      <div class="trust-badge-wrap">
        <span class="trust-check-icon">✓</span>
        <span class="trust-badge-label">FACT CHECKED & EXAM VERIFIED</span>
      </div>
      <p class="trust-text">
        This guide is compiled from official government recruitment notifications, staff selection commission evaluation formulas, and actual examination software interfaces. Updated for <strong>2026 examination cycles</strong> by the <strong>TypingWire Editorial Board</strong>.
      </p>
    </div>

    <!-- Interactive FAQ Section if present -->
    {
      faqs && faqs.length > 0 && (
        <section class="faq-container">
          <h2 class="headline">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <span class="faq-icon">+</span>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <!-- Tags (Clickable for Topic Silo Crawling) -->
    {
      tags.length > 0 && (
        <div class="tags-section">
          <span class="tags-label">INDEXED UNDER:</span>
          <div class="tags-list">
            {tags.map((t) => (
              <a href={`/tags/${t.toLowerCase().replace(/\s+/g, '-')}`} class="tag-pill">
                #{t}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Related Examination & Speed Guides (Internal Linking Engine) -->
    {
      relatedPosts && relatedPosts.length > 0 && (
        <section class="related-guides-section">
          <div class="related-header">
            <span class="post-card-badge badge-lilac">TOPICAL CLUSTER</span>
            <h2 class="headline">Recommended Exam & Speed Guides</h2>
            <p class="related-subtitle">Continue mastering typing formulas, software rules, and error calculations.</p>
          </div>
          <div class="related-grid">
            {relatedPosts.map((relPost) => (
              <BlogCard
                title={relPost.data.title}
                description={relPost.data.description}
                pubDate={relPost.data.pubDate}
                slug={relPost.id}
                category={relPost.data.category}
                tags={relPost.data.tags}
                heroImage={relPost.data.heroImage}
                imageAlt={relPost.data.imageAlt}
              />
            ))}
          </div>
        </section>
      )
    }

    <!-- High-conversion Pastel CTA Card (Mint Block) -->
    <div class="post-cta-block">
      <div class="cta-inner">
        <span class="post-card-badge" style="background:#ffffff;">TYPING PRACTICE</span>
        <h3>Benchmark Your Keystrokes on TypingWire</h3>
        <p>Real-time accuracy analysis, exam passages, and speed benchmarks.</p>
        <a href="https://typingwire.in" target="_blank" rel="noopener noreferrer" class="button-primary">
          Start Typing Test →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-detail-wrapper {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .breadcrumb-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--colors-muted-text);
    margin-bottom: 2rem;
  }

  .breadcrumb-bar a {
    color: var(--colors-primary);
  }

  .breadcrumb-bar a:hover {
    text-decoration: underline;
  }

  .post-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--colors-hairline);
    padding-bottom: 2.5rem;
  }

  .header-tags {
    margin-bottom: 1.25rem;
  }

  .post-title {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .post-lead {
    font-size: 20px;
    color: var(--colors-muted-text);
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colors-muted-text);
  }

  .author-info, .publish-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .author-label, .date-label {
    color: var(--colors-muted-text);
    font-weight: 500;
  }

  .author-info, .reviewer-info, .publish-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .author-label, .date-label {
    color: var(--colors-muted-text);
    font-weight: 500;
  }

  .author-name {
    color: var(--colors-primary);
    font-weight: 600;
  }

  .meta-sep {
    color: var(--colors-hairline);
  }

  /* Table of Contents (SERP Sitelinks Generator) */
  .toc-card {
    background-color: var(--colors-surface-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 3rem;
  }

  .toc-details {
    width: 100%;
  }

  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--colors-primary);
    list-style: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-icon {
    font-size: 10px;
    color: var(--colors-muted-text);
    transition: transform 0.2s ease;
  }

  .toc-details[open] .toc-icon {
    transform: rotate(180deg);
  }

  .toc-list {
    margin-top: 1rem;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toc-item {
    font-size: 14px;
    line-height: 1.5;
  }

  .toc-link {
    color: var(--colors-primary);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .toc-number {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--colors-muted-text);
    font-weight: 600;
  }

  .toc-link:hover {
    color: #047857;
    text-decoration: underline;
  }

  /* FAQs */
  .faq-container {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--colors-hairline);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .faq-item {
    padding: 1.25rem 1.5rem;
    background-color: var(--colors-surface-soft);
    border: 1px solid var(--colors-hairline);
    border-radius: var(--rounded-md);
  }

  .faq-question {
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--colors-primary);
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-answer {
    margin-top: 0.75rem;
    font-size: 15px;
    color: var(--colors-body-text);
    line-height: 1.65;
  }

  /* Editorial Trust Box (E-E-A-T) */
  .editorial-trust-box {
    margin-top: 3.5rem;
    padding: 1.5rem 1.75rem;
    background-color: var(--colors-surface-soft);
    border: 1px solid var(--colors-hairline);
    border-left: 4px solid var(--colors-primary);
    border-radius: var(--rounded-md);
  }

  .trust-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .trust-check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: #0f8b44;
    color: #ffffff;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
  }

  .trust-badge-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--colors-primary);
  }

  .trust-text {
    font-size: 13.5px;
    color: var(--colors-muted-text);
    line-height: 1.6;
    margin: 0;
  }

  .trust-text strong {
    color: var(--colors-primary);
  }

  /* Tags */
  .tags-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colors-muted-text);
    font-weight: 600;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--colors-surface-soft);
    color: var(--colors-primary);
    padding: 0.25rem 0.65rem;
    border-radius: var(--rounded-xs);
    border: 1px solid var(--colors-hairline);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .tag-pill:hover {
    background: var(--colors-primary);
    color: #ffffff;
    border-color: var(--colors-primary);
  }

  /* Related Guides Section */
  .related-guides-section {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--colors-hairline);
  }

  .related-header {
    margin-bottom: 2rem;
  }

  .related-header .headline {
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
    font-size: 24px;
    font-weight: 700;
  }

  .related-subtitle {
    font-size: 14.5px;
    color: var(--colors-muted-text);
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  /* CTA Banner */
  .post-cta-block {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    background-color: var(--colors-block-mint);
    border: 1px solid #bbf7e6;
    border-radius: var(--rounded-lg);
  }

  .post-cta-block h3 {
    margin: 1rem 0 0.5rem;
    font-size: 24px;
    color: #064e3b;
    font-weight: 700;
  }

  .post-cta-block p {
    margin: 0 0 1.5rem;
    color: #047857;
    font-size: 15.5px;
  }

  @media (max-width: 768px) {
    .blog-detail-wrapper {
      padding-top: 2.5rem;
    }
    .post-cta-block {
      padding: 2rem 1.5rem;
    }
  }
</style>
